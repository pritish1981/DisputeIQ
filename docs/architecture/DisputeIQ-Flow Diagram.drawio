        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\nsubgraph ENTRY[1. Entry Points]\n    E1[Customer Web or Mobile]\n    E2[Analyst or Reviewer]\n    E3[Partner API]\n    E4[Email or SMS]\nend\n\nsubgraph EDGE[2. Edge and Security]\n    S1[Cloudflare Edge]\n    S2[WAF]\n    S3[DDoS Protection]\n    S4[Rate Limiting]\n    S5[Zero Trust Access]\nend\n\nsubgraph APP[3. Application Layer]\n    A1[API Gateway]\n    A2[Auth and RBAC]\n    A3[Request Validation]\n    A4[Idempotency Check]\n    A5[Case Service]\n    A6[Workflow Service]\n    A7[Audit API]\nend\n\nsubgraph GRAPH[4. LangGraph Orchestration]\n    G1[Intake and Normalize]\n    G2[Classify and Route]\n    G3[Acquire Authoritative Context]\n    G4[Assess Evidence Completeness]\n    G5[Resolve Policy Context]\n    G6[Execute Decision Rules]\n    G7[Case Confidence and Escalation]\n    G8[Generate Recommendation]\n    G9[Human Decision]\n    G10[Generate Approved Communication]\n    G11[Finalize and Audit]\nend\n\nsubgraph HITL[Human Review Paths]\n    H1[Manual Classification]\n    H2[Request Additional Evidence]\n    H3[Policy Review]\n    H4[Manual Exception Review]\n    H5[Supervisor Review]\nend\n\nsubgraph AI[5. AI Assisted Capabilities]\n    AI1[Classification Service]\n    AI2[Evidence Analysis Service]\n    AI3[Recommendation Service]\n    AI4[Communication Service]\n    AI5[Model Gateway]\nend\n\nsubgraph DET[6. Deterministic and Controlled Services]\n    D1[Policy Eligibility Service]\n    D2[Evidence Completeness Service]\n    D3[Rules Engine]\n    D4[Case Confidence Service]\n    D5[Idempotency Validation]\nend\n\nsubgraph TOOLS[7. Authoritative Data and Tool Adapters]\n    T1[Customer Provider]\n    T2[Account Provider]\n    T3[Transaction Provider]\n    T4[Settlement Provider]\n    T5[Merchant Provider]\n    T6[Refund Provider]\nend\n\nsubgraph PLATFORM[8. Platform Services]\n    P1[Audit Event Service]\n    P2[Notification Service]\n    P3[Task and Case Service]\n    P4[Evidence Service]\n    P5[Search Service]\nend\n\nsubgraph DATA[9. Data and State Layer]\n    DB1[PostgreSQL Operational DB]\n    DB2[PostgreSQL Checkpoint Store]\n    DB3[pgvector Policy Knowledge]\n    DB4[Redis Cache Queue Lock]\n    DB5[Object Storage Evidence Files]\n    DB6[Immutable Audit Store]\nend\n\nsubgraph AIGOV[10. AI Platform Governance]\n    C1[AI Configuration Registry]\n    C2[Prompt Manager]\n    C3[Feature Flags and Kill Switch]\n    C4[Data and Model Usage Policy]\nend\n\nsubgraph MODELS[11. Model Providers]\n    M1[OpenAI]\n    M2[Azure OpenAI]\n    M3[Anthropic]\n    M4[Embedding Provider]\n    M5[Reranker Provider]\nend\n\nsubgraph EXT[12. Integrations and External Systems]\n    X1[Customer Service]\n    X2[Account Service]\n    X3[Transaction Service]\n    X4[Settlement Service]\n    X5[Merchant Service]\n    X6[Refund Service]\n    X7[Email SMS Gateway]\n    X8[Identity Service]\n    X9[Fraud System]\n    X10[Payment Network]\n    X11[Regulatory System]\nend\n\nsubgraph DEVOPS[13. Engineering Delivery and Governance]\n    V1[OpenSpec]\n    V2[GitHub Repository]\n    V3[GitHub Actions CI CD]\n    V4[Testing and Security Scans]\n    V5[AI Evaluation]\n    V6[Quality Gates]\n    V7[Deploy to Staging]\n    V8[Approval Gate]\n    V9[Deploy to Production]\nend\n\nsubgraph OBS[14. Observability and AI Quality]\n    O1[OpenTelemetry]\n    O2[LangSmith]\n    O3[LangWatch]\n    O4[Dashboards and Alerts]\nend\n\nsubgraph OUT[15. Outputs]\n    O5[Customer Communication]\n    O6[Case Outcome]\n    O7[Operational Dashboard]\n    O8[Audit Report]\n    O9[Alerts and Notifications]\nend\n\nsubgraph CROSS[16. Cross Cutting Concerns]\n    C5[Security]\n    C6[Privacy]\n    C7[Compliance]\n    C8[Data Quality]\n    C9[Reliability]\n    C10[Scalability]\n    C11[Observability]\n    C12[Cost Optimization]\n    C13[Business Continuity]\nend\n\n\nE1 --&gt; S1\nE2 --&gt; S1\nE3 --&gt; S1\nE4 --&gt; S1\n\nS1 --&gt; S2\nS2 --&gt; S3\nS3 --&gt; S4\nS4 --&gt; 